# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Signs auth tokens. There is no fallback value in the code on purpose: a
# committed default would let anyone who reads this repo forge sessions.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Browser origins allowed to call this API with cookies attached.
# Comma-separated, exact origins only — no wildcards, since auth is cookie-based.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Where the SQLite file lives. Defaults to ./data/cv_matcher.db.
# Point this at a mounted volume in production, never at /tmp.
DB_PATH=./data/cv_matcher.db

# Set to "production" to make a missing JWT_SECRET a hard startup failure.
ENV=development
